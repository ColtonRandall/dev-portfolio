{
  "name": "dev-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "predeploy": "npm run build",
    "deploy:github": "npm run deploy",
    "deploy:aws": "cd infra && terraform apply -auto-approve",
    "deploy:all": "npm run build && npm run deploy:github && npm run deploy:aws",
    "typecheck": "tsc",
    "format": "prettier --write index.html src",
    "test": "vitest run",
    "check": "tsc && vitest run"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
